# Copy this file to .env for local development. .env itself is gitignored.
#
# For local dev (default, recommended for everyday work):
APP_ENV=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=apartment_finder
POSTGRES_USERNAME=apartment_finder
POSTGRES_PASSWORD=local_dev_only
# These match docker-compose.yml exactly — don't change one without the other.

# For running against the real Azure database (rare — only when you
# deliberately mean to touch production data), set APP_ENV=cloud and
# fill these in from `terraform output` instead:
# APP_ENV=cloud
# POSTGRES_HOST=<terraform output server_fqdn>
# POSTGRES_DATABASE=apartment_finder
# POSTGRES_ADMIN_USERNAME=<terraform output admin_username>
# KEY_VAULT_NAME=<terraform output key_vault_name>
# (No password here — it's fetched from Key Vault automatically.)

# Azure Blob Storage — only needed if actually downloading images
# (both local and cloud runs currently use the same real storage account,
# since there's no cheap local equivalent to Blob Storage):
AZURE_STORAGE_ACCOUNT_NAME=stapartmentimages
AZURE_STORAGE_CONTAINER_NAME=listing-images

# Verbosity for every run (the --log-level flag overrides this).
# debug traces every results page, parsed field and image URL.
LOG_LEVEL=info

# POI teacher labeling (training/label_with_teacher.py). Real keys go in
# .env only. See training/README.md for providers and OpenAI-compatible servers.
# TEACHER_PROVIDER=openai        # openai | anthropic | gemini | groq | ollama
# TEACHER_MODEL=                 # default: the provider's default model
# TEACHER_EFFORT=medium          # "default" sends no effort parameter
# OPENAI_API_KEY=sk-...          # platform.openai.com key, not a ChatGPT login
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=                # free: aistudio.google.com/apikey
# GROQ_API_KEY=                  # free: console.groq.com/keys
# TEACHER_MIN_INTERVAL=          # seconds between requests on free tiers
